# Workbench identity and local routing
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME=Vuln Prioritizer Workbench
STACK_NAME=vuln-prioritizer-workbench
VITE_API_URL=http://localhost:8000

# Backend local-only placeholders. Replace these before any shared deployment.
SECRET_KEY=local-workbench-dev-secret
LOCAL_WORKBENCH_USER_EMAIL=local@workbench.test
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
# Leave blank to expose API docs only in local mode by default.
API_DOCS_ENABLED=

# Optional Traefik dashboard exposure. Leave disabled unless you also set a
# narrow source range for the operator network and a htpasswd-compatible
# user hash, for example from:
# printf 'admin:%s\n' "$(openssl passwd -apr1 'replace-this-password')"
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_DASHBOARD_IP_ALLOWLIST=127.0.0.1/32
TRAEFIK_DASHBOARD_AUTH_USERS=

# Local Compose database defaults.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=local-workbench-dev-postgres-password

# Optional Compose volume overrides. Fresh stacks default to Workbench-branded
# names.
WORKBENCH_DB_VOLUME=workbench-db-data
WORKBENCH_IMPORT_UPLOADS_VOLUME=workbench-import-uploads
WORKBENCH_REPORTS_VOLUME=workbench-reports
WORKBENCH_PROVIDER_SNAPSHOTS_VOLUME=workbench-provider-snapshots
WORKBENCH_PROVIDER_CACHE_VOLUME=workbench-provider-cache

# Container images.
DOCKER_IMAGE_BACKEND=vuln-prioritizer-workbench-backend
DOCKER_IMAGE_FRONTEND=vuln-prioritizer-workbench-frontend
TAG=local

# Vuln Prioritizer provider and Workbench settings.
NVD_API_KEY=
DEMO_PROVIDER_SNAPSHOT_ENABLED=false
VULN_PRIORITIZER_NVD_API_KEY_ENV=NVD_API_KEY
MAX_UPLOAD_MB=25
MAX_REPORT_MB=50
MAX_REPORTS_PER_RUN=20

# Optional runtime safety limits. Keep the defaults for local single-user use.
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=600
DECISION_API_MAX_FINDINGS=1000
TRUSTED_PROXY_CIDRS=
AUDIT_RETENTION_DAYS=365
TRAEFIK_APP_ENABLED=false
TRAEFIK_API_ENABLED=false
TRAEFIK_MAX_REQUEST_BODY_BYTES=26214400
