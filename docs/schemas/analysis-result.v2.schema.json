{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noetheon.github.io/vuln-prioritizer-workbench/schemas/analysis-result.v2.schema.json",
  "title": "vuln-prioritizer-workbench analysis result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "project",
    "analysis_run",
    "provider_snapshot",
    "findings",
    "explanations"
  ],
  "properties": {
    "schema": {
      "const": "analysis-result.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "generated_at": {
      "$ref": "#/$defs/dateTime"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "analysis_run": {
      "$ref": "#/$defs/analysisRun"
    },
    "provider_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/providerSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "governance_rollups": {
      "$ref": "#/$defs/governanceRollups"
    },
    "detection_coverage": {
      "$ref": "#/$defs/detectionCoverage"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "explanations": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nullableUuid": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "nullableDateTime": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": true
    },
    "integerCountMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "updated_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "context_source": {
          "type": "string",
          "enum": [
            "current_project_projection_at_export"
          ]
        }
      }
    },
    "analysisRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "status",
        "input_type",
        "filename",
        "started_at",
        "finished_at",
        "error_message",
        "errors",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "type": "string"
        },
        "input_type": {
          "type": "string"
        },
        "filename": {
          "$ref": "#/$defs/nullableString"
        },
        "started_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "finished_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "error_message": {
          "$ref": "#/$defs/nullableString"
        },
        "errors": {
          "$ref": "#/$defs/jsonObject"
        },
        "summary": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "providerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "content_hash",
        "nvd_last_sync",
        "epss_date",
        "kev_catalog_version",
        "source_hashes",
        "source_metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "content_hash": {
          "$ref": "#/$defs/nullableString"
        },
        "nvd_last_sync": {
          "$ref": "#/$defs/nullableString"
        },
        "epss_date": {
          "$ref": "#/$defs/nullableString"
        },
        "kev_catalog_version": {
          "$ref": "#/$defs/nullableString"
        },
        "source_hashes": {
          "$ref": "#/$defs/jsonObject"
        },
        "source_metadata": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "governanceRollups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "generated_at",
        "owners",
        "services",
        "assets",
        "environments",
        "top_services_by_risk",
        "top_assets_by_risk",
        "waiver_debt"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "generated_at": {
          "$ref": "#/$defs/dateTime"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceRollup"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceRollup"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceRollup"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceRollup"
          }
        },
        "top_services_by_risk": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceRollup"
          }
        },
        "top_assets_by_risk": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceRollup"
          }
        },
        "waiver_debt": {
          "$ref": "#/$defs/governanceWaiverDebt"
        }
      }
    },
    "governanceRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "label",
        "finding_count",
        "open_count",
        "accepted_count",
        "fixed_count",
        "suppressed_count",
        "critical_count",
        "high_count",
        "kev_count",
        "attack_mapped_count",
        "suppressed_by_vex_count",
        "under_investigation_count",
        "waived_count",
        "expired_waiver_count",
        "review_due_waiver_count",
        "risk_score_total",
        "risk_score_max",
        "highest_priority",
        "priority_counts",
        "status_counts",
        "top_cves"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "owner",
            "service",
            "asset",
            "environment"
          ]
        },
        "label": {
          "type": "string"
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_count": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_count": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_count": {
          "type": "integer",
          "minimum": 0
        },
        "critical_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "kev_count": {
          "type": "integer",
          "minimum": 0
        },
        "attack_mapped_count": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_by_vex_count": {
          "type": "integer",
          "minimum": 0
        },
        "under_investigation_count": {
          "type": "integer",
          "minimum": 0
        },
        "waived_count": {
          "type": "integer",
          "minimum": 0
        },
        "expired_waiver_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_due_waiver_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_score_total": {
          "type": "number"
        },
        "risk_score_max": {
          "$ref": "#/$defs/nullableNumber"
        },
        "highest_priority": {
          "$ref": "#/$defs/nullableString"
        },
        "priority_counts": {
          "$ref": "#/$defs/integerCountMap"
        },
        "status_counts": {
          "$ref": "#/$defs/integerCountMap"
        },
        "top_cves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governanceWaiverDebt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_count",
        "active_count",
        "review_due_count",
        "expired_count",
        "expiring_soon_count",
        "matched_finding_count",
        "accepted_finding_count",
        "expired_finding_count",
        "review_due_finding_count",
        "owner_counts",
        "service_counts",
        "items"
      ],
      "properties": {
        "waiver_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_due_count": {
          "type": "integer",
          "minimum": 0
        },
        "expired_count": {
          "type": "integer",
          "minimum": 0
        },
        "expiring_soon_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "expired_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_due_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "owner_counts": {
          "$ref": "#/$defs/integerCountMap"
        },
        "service_counts": {
          "$ref": "#/$defs/integerCountMap"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governanceWaiverDebtEntry"
          }
        }
      }
    },
    "governanceWaiverDebtEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "scope",
        "status",
        "days_remaining",
        "expires_at",
        "review_at",
        "matched_findings",
        "cve_id",
        "service",
        "asset_key",
        "finding_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "owner": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "review_due",
            "expired"
          ]
        },
        "days_remaining": {
          "type": "integer"
        },
        "expires_at": {
          "$ref": "#/$defs/date"
        },
        "review_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_findings": {
          "type": "integer",
          "minimum": 0
        },
        "cve_id": {
          "$ref": "#/$defs/nullableString"
        },
        "service": {
          "$ref": "#/$defs/nullableString"
        },
        "asset_key": {
          "$ref": "#/$defs/nullableString"
        },
        "finding_id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        },
        "approval_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "ticket_url": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "detectionCoverage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": {
          "$ref": "#/$defs/integerCountMap"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detectionCoverageItem"
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detectionControl"
          }
        },
        "note": {
          "$ref": "#/$defs/nullableString"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "detectionCoverageItem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "technique_id": {
          "type": "string",
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
        },
        "name": {
          "$ref": "#/$defs/nullableString"
        },
        "tactic_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "critical_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "kev_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_level": {
          "$ref": "#/$defs/detectionCoverageLevel"
        },
        "control_count": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_action": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "detectionControl": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nullableString"
        },
        "project_id": {
          "$ref": "#/$defs/nullableString"
        },
        "control_id": {
          "$ref": "#/$defs/nullableString"
        },
        "name": {
          "type": "string"
        },
        "technique_id": {
          "type": "string",
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
        },
        "technique_name": {
          "$ref": "#/$defs/nullableString"
        },
        "source_type": {
          "$ref": "#/$defs/nullableString"
        },
        "coverage_level": {
          "$ref": "#/$defs/detectionCoverageLevel"
        },
        "environment": {
          "$ref": "#/$defs/nullableString"
        },
        "owner": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "type": "string"
        },
        "history_count": {
          "type": "integer",
          "minimum": 0
        },
        "attachment_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        },
        "last_verified_at": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "detectionCoverageLevel": {
      "enum": [
        "covered",
        "partial",
        "not_covered",
        "unknown",
        "not_applicable"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cve_id",
        "status",
        "priority",
        "priority_raw",
        "priority_rank",
        "operational_rank",
        "dedup_key",
        "risk_score",
        "epss",
        "cvss_base_score",
        "in_kev",
        "attack_mapped",
        "suppressed_by_vex",
        "under_investigation",
        "waived",
        "asset",
        "component",
        "vulnerability",
        "recommendation",
        "data_quality",
        "explanation",
        "evidence",
        "occurrences",
        "first_seen_at",
        "last_seen_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "cve_id": {
          "type": "string",
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "priority_raw": {
          "type": "string"
        },
        "priority_rank": {
          "type": [
            "integer",
            "null"
          ]
        },
        "operational_rank": {
          "type": "integer"
        },
        "dedup_key": {
          "$ref": "#/$defs/nullableString"
        },
        "risk_score": {
          "$ref": "#/$defs/nullableNumber"
        },
        "epss": {
          "$ref": "#/$defs/nullableNumber"
        },
        "cvss_base_score": {
          "$ref": "#/$defs/nullableNumber"
        },
        "in_kev": {
          "type": "boolean"
        },
        "attack_mapped": {
          "type": "boolean"
        },
        "suppressed_by_vex": {
          "type": "boolean"
        },
        "under_investigation": {
          "type": "boolean"
        },
        "waived": {
          "type": "boolean"
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "vulnerability": {
          "$ref": "#/$defs/jsonObject"
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "data_quality": {
          "$ref": "#/$defs/dataQuality"
        },
        "explanation": {
          "$ref": "#/$defs/jsonObject"
        },
        "evidence": {
          "$ref": "#/$defs/jsonObject"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        },
        "first_seen_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "last_seen_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "updated_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "asset_key",
        "owner",
        "business_service",
        "environment",
        "exposure",
        "criticality"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nullableString"
        },
        "asset_key": {
          "$ref": "#/$defs/nullableString"
        },
        "owner": {
          "$ref": "#/$defs/nullableString"
        },
        "business_service": {
          "$ref": "#/$defs/nullableString"
        },
        "environment": {
          "$ref": "#/$defs/nullableString"
        },
        "exposure": {
          "$ref": "#/$defs/nullableString"
        },
        "criticality": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "purl"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nullableString"
        },
        "purl": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "recommended_action",
        "decision_guidance",
        "decision_statement",
        "decision_sla",
        "business_impact"
      ],
      "properties": {
        "rationale": {
          "$ref": "#/$defs/nullableString"
        },
        "recommended_action": {
          "$ref": "#/$defs/nullableString"
        },
        "decision_guidance": {
          "$ref": "#/$defs/jsonObject"
        },
        "decision_statement": {
          "$ref": "#/$defs/nullableString"
        },
        "decision_sla": {
          "$ref": "#/$defs/nullableString"
        },
        "business_impact": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "flags",
        "raw"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/nullableString"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "analysis_run_id",
        "source",
        "raw_reference",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "analysis_run_id": {
          "$ref": "#/$defs/uuid"
        },
        "source": {
          "$ref": "#/$defs/nullableString"
        },
        "scanner": {
          "$ref": "#/$defs/nullableString"
        },
        "raw_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "fix_version": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    }
  }
}
