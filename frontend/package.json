{
  "name": "frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "biome lint --no-errors-on-unmatched --files-ignore-unknown=true index.html src tests vite.config.ts openapi-ts.config.ts playwright.config.ts package.json tsconfig.json tsconfig.build.json tsconfig.node.json components.json",
    "lint:fix": "biome lint --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true index.html src tests vite.config.ts openapi-ts.config.ts playwright.config.ts package.json tsconfig.json tsconfig.build.json tsconfig.node.json components.json",
    "preview": "vite preview --host 127.0.0.1",
    "generate-client": "openapi-ts",
    "test": "playwright test",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:unit:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/auth.ts' --test-coverage-include='src/lib/**/*.ts' --test-coverage-include='src/components/findings/*-state.ts' --test-coverage-include='src/components/imports/*-model.ts' --test-coverage-include='src/components/reports/*-model.ts' --test-coverage-include='src/workbench/*.ts' --test-coverage-exclude='src/client/**' --test-coverage-exclude='src/routeTree.gen.ts' --test-coverage-exclude='src/vite-env.d.ts' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 tests/*.test.ts",
    "test:pr-frontend": "npm run test:unit:coverage && npm run test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.15",
    "@hey-api/openapi-ts": "0.97.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
