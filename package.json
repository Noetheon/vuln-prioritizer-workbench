{
  "name": "vuln-prioritizer-workbench",
  "description": "Local-first Workbench for prioritizing known CVEs from existing evidence.",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10.9 <11"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run dev",
    "lint": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run lint",
    "test": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run test",
    "test:ui": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run test:ui",
    "frontend:build": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run build",
    "frontend:generate-client": "bash scripts/generate-client.sh",
    "frontend:lint": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run lint",
    "frontend:test": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run test",
    "frontend:test:unit": "scripts/frontend-npm.sh --prefix frontend --workspaces=false --engine-strict=true run test:unit"
  }
}
